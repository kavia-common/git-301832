{"is_source_file": true, "format": "C header file", "description": "This header file defines the data structures, function prototypes, and enums used for managing and classifying filesystem monitoring daemon state, including batching paths, classifying paths relative to the working directory and .git directory, and handling inter-thread communication.", "external_files": ["hashmap.h", "thread-utils.h", "fsmonitor-path-utils.h"], "external_methods": [], "published": ["fsmonitor_batch__new", "fsmonitor_batch__free_list", "fsmonitor_batch__add_path", "fsmonitor_classify_path_workdir_relative", "fsmonitor_classify_path_gitdir_relative", "fsmonitor_classify_path_absolute", "fsmonitor_publish", "fsmonitor_force_resync"], "classes": [], "methods": [{"name": "fsmonitor_batch__new", "description": "Creates and returns a new fsmonitor batch object, which is intended to be filled with paths for monitoring."}, {"name": "fsmonitor_batch__free_list", "description": "Frees a list of fsmonitor batches starting from the provided batch pointer."}, {"name": "fsmonitor_batch__add_path", "description": "Adds a specified filesystem path to the given batch object. This batch is private and not yet linked into the daemon state."}, {"name": "fsmonitor_classify_path_workdir_relative", "description": "Classifies a relative pathname (from the work directory) into a specific enum indicating its category."}, {"name": "fsmonitor_classify_path_gitdir_relative", "description": "Classifies a relative pathname (from an external GITDIR) into an enum indicating its category."}, {"name": "fsmonitor_classify_path_absolute", "description": "Classifies an absolute pathname received from filesystem events into an enum indicating its relation to the repository or worktree."}, {"name": "fsmonitor_publish", "description": "Publishes a batch of paths associated with a token, making them visible to worker threads and waking up any waiting clients."}, {"name": "fsmonitor_force_resync", "description": "Invalidates