{"is_source_file": true, "format": "sh/shell script", "description": "This file is a shell script for testing the output of 'git status' in various complex scenarios within the Git version control system. It sets up multiple repositories and scenarios such as conflicts during merge, rebase, cherry-pick, bisect, revert, and during an ongoing 'git am' session. The script defines test cases that execute Git commands and compare the actual 'git status' output against expected outputs to verify correct behavior during different states of repository operations.", "external_files": ["./test-lib.sh", "$TEST_DIRECTORY/lib-rebase.sh"], "external_methods": [], "published": ["test_expect_success", "test_must_fail", "test_must_be_empty", "test_write_lines", "test_cmp", "test_when_finished"], "classes": [], "methods": [], "calls": ["git config", "git branch", "git checkout", "git commit", "git merge", "git status", "git reset", "git add", "git rebase", "git format-patch", "git am", "git cherry-pick", "git revert", "git bisect", "git checkout", "git rev-parse", "git test", "git test", "test_write_lines", "test_cmp", "test_when_finished", "test_must_fail", "test_must_be_empty"], "search-terms": ["git status", "conflict", "rebase", "cherry-pick", "bisect", "revert", "am session", "patch", "am", "interactive rebase", "drop", "split", "edit", "amend", "cherry", "detached", "tag", "revert", "conflicts", "not-yet-started rebase", "status hints", "sequencer", "dirty state", "staged", "unstaged", "unmerged", "skip", "continue", "abort", "empty patch", "multiple commits", "bisect in progress"], "state": 2, "file_id": 787, "knowledge_revision": 7269, "git_revision": "e42667241de12840ef58c0ba1c060b86c850bae0", "hash": "ee9594e89d8221caac2e76a18f534771", "format-version": 4, "code-base-name": "git-301832", "filename": "t/t7512-status-help.sh", "revision_history": [{"7269": "e42667241de12840ef58c0ba1c060b86c850bae0"}]}