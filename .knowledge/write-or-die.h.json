{"is_source_file": true, "format": "C header file", "description": "This file declares functions and enums related to ensuring data integrity via flushing data to storage (fsync) operations. It defines interface functions such as 'maybe_flush_or_die' and 'fsync_or_die', as well as functions for writing data with error checking. It also includes an enumeration for different repository components that can be synchronized, along with macros to combine these components according to different criteria. Additionally, it declares external variables controlling fsync behavior and an inline function to check if batch fsync is enabled for a specific component.", "external_files": [], "external_methods": ["fprintf_or_die"], "published": ["maybe_flush_or_die", "fprintf_or_die", "fwrite_or_die", "fflush_or_die", "write_or_die", "fsync_or_die", "fsync_component", "fsync_component_or_die"], "classes": [], "methods": [{"name": "maybe_flush_or_die", "description": "Flushes data to storage if necessary, terminating on failure."}, {"name": "fprintf_or_die", "description": "Formatted print to a FILE stream with error checking, terminates on failure."}, {"name": "fwrite_or_die", "description": "Writes data to a FILE stream with error checking, terminates on failure."}, {"name": "fflush_or_die", "description": "Flushes a FILE stream with error checking, terminates on failure."}, {"name": "write_or_die", "description": "Writes data directly to a file descriptor with error checking, terminates on failure."}, {"name": "fsync_or_die", "description": "Synchronizes a file descriptor with storage, terminates on failure."}, {"name": "fsync_component", "description": "Synchronizes specific components of a repository, identified by enum."}, {"name": "fsync_component_or_die", "description": "Synchronizes specific repository components with error checking, terminates on failure."}, {"name": "int batch_fsync_enabled(enum fsync_component component)", "scope": "", "scopeKind": "", "description": "unavailable"}], "calls": ["fprintf_or_die", "fwrite_or_die", "fflush_or_die", "write_or_die", "fsync_or_die", "fsync_component", "fsync_component_or_die"], "search-terms": ["fsync", "write_or_die", "component", "repository", "flush", "fsync_method"], "state": 2, "file_id": 3217, "knowledge_revision": 9702, "git_revision": "d48be35ca6f62e1ddd0161f9bbb4c893ee498bfe", "ctags": [{"_type": "tag", "name": "FSYNC_COMPONENTS_ADDED", "path": "/home/kavia/workspace/code-generation/git-301832/write-or-die.h", "pattern": "/^#define FSYNC_COMPONENTS_ADDED /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "FSYNC_COMPONENTS_ALL", "path": "/home/kavia/workspace/code-generation/git-301832/write-or-die.h", "pattern": "/^#define FSYNC_COMPONENTS_ALL /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "FSYNC_COMPONENTS_COMMITTED", "path": "/home/kavia/workspace/code-generation/git-301832/write-or-die.h", "pattern": "/^#define FSYNC_COMPONENTS_COMMITTED /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "FSYNC_COMPONENTS_DEFAULT", "path": "/home/kavia/workspace/code-generation/git-301832/write-or-die.h", "pattern": "/^#define FSYNC_COMPONENTS_DEFAULT /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "FSYNC_COMPONENTS_DERIVED_METADATA", "path": "/home/kavia/workspace/code-generation/git-301832/write-or-die.h", "pattern": "/^#define FSYNC_COMPONENTS_DERIVED_METADATA /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "FSYNC_COMPONENTS_OBJECTS", "path": "/home/kavia/workspace/code-generation/git-301832/write-or-die.h", "pattern": "/^#define FSYNC_COMPONENTS_OBJECTS /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "FSYNC_COMPONENTS_PLATFORM_DEFAULT", "path": "/home/kavia/workspace/code-generation/git-301832/write-or-die.h", "pattern": "/^#define FSYNC_COMPONENTS_PLATFORM_DEFAULT /", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "FSYNC_COMPONENT_COMMIT_GRAPH", "path": "/home/kavia/workspace