{"is_source_file": true, "format": "Shell script (sh)", "description": "This script converts a tab-separated text file into a PO/POT file used for translations. It includes usage instructions, argument checks, file existence verification, and formats the output as a gettext message catalog.", "external_files": ["$GLOSSARY_CSV"], "external_methods": ["awk"], "published": [], "classes": [], "methods": [], "calls": ["awk -F'\\t' '{if ($2 != \"\") print \"#. \"$2; print \"msgid \"$1; print \"msgstr \"\"\\n\"}' $GLOSSARY_CSV"], "search-terms": ["txt-to-pot.sh", "shell script", "gettext", "translation file converter", "awk", "tab-separated", "PO file", "POT file"], "state": 2, "file_id": 3077, "knowledge_revision": 9559, "git_revision": "4796af1510b2dd997d1068755af9910a5ddb60d6", "hash": "2aabb21dc72e2cb155ad3eaecd343111", "format-version": 4, "code-base-name": "git-301832", "filename": "git-gui/po/glossary/txt-to-pot.sh", "revision_history": [{"9559": "4796af1510b2dd997d1068755af9910a5ddb60d6"}]}